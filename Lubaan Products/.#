            </button>
            <button class="filter-btn" data-filter="Kilinik">
                <i class="fas fa-clinic-medical"></i> Kilinik
            </button>
            <button class="filter-btn" data-filter="Pharmacy">
                <i class="fas fa-prescription-bottle-alt"></i> Pharmacy
            </button>
        </div>

        <!-- Results count -->
        <p class="results-count" id="resultsCount">15 goobood oo la helay</p>
